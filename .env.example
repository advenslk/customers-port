# GEMINI_API_KEY: Optional Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where the portal is hosted (e.g. https://customers.helzerx.cyou)
APP_URL="https://customers.helzerx.cyou"

# JWT_SECRET: Cryptographic secret for signing HTTP-only session cookies
JWT_SECRET="replace-with-64-char-random-secret"

# DATABASE_PATH: SQLite database file path (defaults to ./data/helzerx.db)
DATABASE_PATH="./data/helzerx.db"

# RESEND_API_KEY: Resend API key for transactional HTML emails
RESEND_API_KEY=""
EMAIL_FROM="HelzerX Billing <billing@helzerx.cyou>"

# DISCORD_WEBHOOK_URL: Backend Discord webhook URL for real-time order/payment/ticket alerts
DISCORD_WEBHOOK_URL=""

# STRIPE_SECRET_KEY & STRIPE_WEBHOOK_SECRET: Optional Stripe server credentials
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ADMIN_BOOTSTRAP_EMAIL & ADMIN_BOOTSTRAP_PASSWORD: Optional initial administrator credentials (min 12 chars)
# If omitted, the portal prompts once for initial Super Admin setup when zero admins exist.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

